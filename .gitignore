# --- ROS2 build artifacts (must never be committed) ---
build/
install/
log/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
.pytest_cache/
.ipynb_checkpoints/

# --- ONNX / model artifacts ---
# Keep tiny exported models if they are part of the demo.
# Large weights go to cloud storage, not here.
*.pt
*.pth
*.weights
# *.onnx

# --- Datasets and recordings (too big for git) ---
data/
datasets/
recordings/
*.bag
*.db3/
*.mcap

# --- Media (put only the small demo gif in docs/) ---
*.mp4
*.mov
*.avi

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Local config with secrets ---
.env
*.local.yaml
